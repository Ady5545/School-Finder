/* CSS used here will be applied after bootstrap.css */
.align-items-center {
    -ms-flex-align: center!important;
    align-items: center!important;
    display: flex;
    justify-content: center;
}
.top-news-title::after{border-top-width:50px}
element.style {
}
.site-branding-shine{
    position: absolute;
    left: 0;
    top: 0;
	opacity:0;
    width: 100px;
    height: 217px;
    display: block;
    -webkit-animation: logoShine1 6s ease-in 1s infinite;
    animation: logoShine1 6s ease-in 1s infinite;
}
@-webkit-keyframes logoShine {
        from {left:-500px;}
        to {left:1000px;}
}
@keyframes logoShine {
        from {left:-500px;}
        to {left:1000px;}
}
.admission-open-btn, .virtual-tour-btn, .virtual-tour-block .blink {
    -webkit-animation-name: blinker;
    -webkit-animation-duration: 2s;
    -webkit-animation-timing-function: linear;
    -webkit-animation-iteration-count: infinite;
    -moz-animation-name: blinker;
    -moz-animation-duration: 2s;
    -moz-animation-timing-function: linear;
    -moz-animation-iteration-count: infinite;
    animation-name: blinker;
    animation-duration: 2s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
}
@-moz-keyframes blinker {  
    0% { opacity: 1.0; }
    50% { opacity: 0.3; }
    100% { opacity: 1.0; }
}
@-webkit-keyframes blinker {  
    0% { opacity: 1.0; }
    50% { opacity: 0.3; }
    100% { opacity: 1.0; }
}
@keyframes blinker {  
    0% { opacity: 1.0; }
    50% { opacity: 0.3; }
    100% { opacity: 1.0; }
}
#quick-contact li.blinking.aff-code{
	  line-height: 1.2;
    font-weight: 600;
    margin-top: 15px;
    font-size: 16px;
    max-width: 320px;
    text-align: center;
}
#quick-contact li.blinking{
	animation:blinkingText 2s infinite;
}
@keyframes blinkingText{
	0%{		opacity: 1;	color:#9E3C3F;}
	55%{	opacity: 0.3; 	color:#000;}
	70%{	opacity: 0.5; 	color:#000;}
	100%{	opacity: 1; 	color:#9E3C3F;}
}
.facilities-container a {
    font-size: 16px;
    line-height: 20px;
    color: #FFF;
	padding:45px;
	padding-left:0px;
	    min-height: 130px;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    position: relative;
    -moz-text-shadow: 1px 1px 1px rgba(0,0,0,0.50);
    -o-text-shadow: 1px 1px 1px rgba(0,0,0,0.50);
    -webkit-text-shadow: 1px 1px 1px rgba(0,0,0,0.50);
    -ms-text-shadow: 1px 1px 1px rgba(0,0,0,0.50);
    text-shadow: 1px 1px 1px rgba(0,0,0,0.50);
}
.lae-testimonial p {
    color: #fff;
}
h2.welcome::before {
    content: none !important;
}
.admission-enquiry{    background: #40b1ef;
    background-image: url(wp-content/uploads/2019/02/ico_cap.png);
    background-repeat: no-repeat;
    background-position: right;
background-blend-mode: soft-light;
	border:3px solid #fff;
}
.event-box{background:#07d8bb;
    background-image: url(wp-content/uploads/2019/02/ico_infra.png);
    background-repeat: no-repeat;
  background-position: center right 10px;
background-blend-mode: soft-light;
	border:3px solid #fff;
}
.achievement-box{background:#f3d052;
    background-image: url(https://sksworldschool.com/wp-content/uploads/2019/02/ico_award.png);
    background-repeat: no-repeat;
    background-position: right;
background-blend-mode: soft-light;
	border:3px solid #fff;
}
.sport-activity-box{background:#f73838;
    background-image: url(https://sksworldschool.com/wp-content/uploads/2019/02/ico_notices.png);
    background-repeat: no-repeat;
    background-position: right;
background-blend-mode: soft-light;
	border:3px solid #fff !important;
}
.facilities-container:hover {
    background-blend-mode: multiply;
}
