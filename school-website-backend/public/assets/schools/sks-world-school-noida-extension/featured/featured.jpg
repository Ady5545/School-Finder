.infrastructure p.description{text-align: justify; display:table;}
.infrastructure span.title{font-size:22px; text-align:left !important; display: inline-block;     line-height: 1.2em; color: #179bd7; margin-bottom: 10px;}
/* css for datepicker */
.unstyled::-webkit-inner-spin-button{
    display: none;
    -webkit-appearance: none;
	appearance:none;
}
input[type="date"]::-webkit-calendar-picker-indicator{
    color: rgba(0, 0, 0, 0);
    opacity: 1;
    display: block;
    background: url(wp-content/uploads/2019/03/calendar_blue.png) no-repeat;
    width: 20px;
    height: 20px;
    border-width: thin;
}
input[type="date"]::-moz-calendar-picker-indicator {
    color: rgba(0, 0, 0, 0);
    opacity: 1;
    display: block;
    background: url(wp-content/uploads/2019/03/calendar_blue.png) no-repeat;
    width: 20px;
    height: 20px;
    border-width: thin;
}
/* end css for datepicker */
/* CSS for Responsive Contact Form 7 */
.content-column.one_half, .content-column.one_half last_column, .fulldiv, .content-column.one_third, .content-column.one_third last_column, .content-column.one_fourth, .content-column.one_fourth last_column {
    padding: 10px;
}
