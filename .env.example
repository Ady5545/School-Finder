# Application
# Public site URL used for canonical links, sitemap and SEO metadata.
# NEXT_PUBLIC_SITE_URL is preferred; NEXT_PUBLIC_APP_URL is accepted as a fallback
# (the legacy Express server in school-website-backend/ also uses it for CORS).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Administrative Access
ADMIN_EMAILS=

# Cryptographic & Session Secrets
SESSION_SECRET=
AUTH_SECRET=
JWT_SECRET=

# Email Infrastructure (SMTP configuration)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_SECURE=

# Database (MONGODB_URI is accepted as an alias of MONGO_URI)
MONGO_URI=

# AI
GEMINI_API_KEY=

# Admin (required in production; ADMIN_PASSWORD is accepted as an alias)
ADMIN_INITIAL_PASSWORD=
